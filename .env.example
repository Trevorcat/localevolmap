# Local Evomap - Configuration
# Since v2026.03.14, the evolution engine runs in pure algorithmic mode.
# LLM configuration is no longer required for core functionality.

# [DEPRECATED] LLM Provider - no longer used by the core engine
# EVOMAP_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LOCAL_LLM_BASE_URL=http://localhost:11434
# EVOMAP_LLM_MODEL=gpt-4o

# Dry Run Mode (true | false)
# When true, changes are logged but not applied to disk
EVOMAP_DRY_RUN=false

# Session Scope (default: local-dev)
EVOMAP_SESSION_SCOPE=local-dev

# Review Mode (true | false)
# Require manual approval for all changes
EVOMAP_REVIEW_MODE=true
