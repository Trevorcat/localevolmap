# LocalEvomap - 测试服配置模板
# 复制此文件为 .env.test 并填入真实值

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=*

# [DEPRECATED] LLM config - no longer used by the core engine (pure algorithmic mode)
# EVOMAP_LLM_PROVIDER=local
# LLM_API_KEY=YOUR_LLM_API_KEY_HERE
# LOCAL_LLM_BASE_URL=https://api-vip.codex-for.me/v1
# EVOMAP_LLM_MODEL=gpt-5.3-codex

# Evolution Config
EVOMAP_DRY_RUN=false
EVOMAP_SESSION_SCOPE=local-dev
EVOMAP_REVIEW_MODE=true
AUTO_APPROVE_LOW_RISK=true

# 测试服数据路径
GENES_PATH=./data/test/genes
CAPSULES_PATH=./data/test/capsules
EVENTS_PATH=./data/test/events

# API Key
HUB_API_KEY=YOUR_HUB_API_KEY_HERE
