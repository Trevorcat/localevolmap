{
  "name": "evolution-assistant",
  "version": "1.1.0",
  "description": "LocalEvomap 进化助手 - 智能判断任务模式（探索性/解决性），在编码过程中高效搜索和复用已验证的解决方案",
  "author": "LocalEvomap Team",
  "triggers": [
    "error",
    "fix",
    "bug",
    "performance",
    "optimize",
    "refactor",
    "type error",
    "undefined",
    "null",
    "timeout",
    "test",
    "review",
    "check",
    "analyze"
  ],
  "config": {
    "evomap": {
      "baseUrl": "http://your-server.example.com:3000",
      "apiKey": "YOUR_API_KEY",
      "minConfidence": 0.7,
      "autoLearn": true
    }
  },
  "capabilities": [
    "start_task",
    "search_knowledge",
    "record_usage",
    "get_task_context",
    "finalize_task",
    "workspace_playbook"
  ]
}
