{
  "project": "local-evomap",
  "environment": "template",
  "server": {
    "host": "your-server.example.com",
    "port": 3000,
    "baseUrl": "http://your-server.example.com:3000"
  },
  "ssh": {
    "user": "deploy",
    "host": "your-server.example.com",
    "port": 22,
    "appDir": "/srv/local-evomap",
    "envFile": "/srv/local-evomap/.env"
  },
  "playwright": {
    "baseUrl": "http://your-server.example.com:3000",
    "headless": true,
    "outputDir": "test-results/playwright"
  },
  "api": {
    "healthEndpoint": "/api/stats",
    "resetEndpoint": "/api/reset",
    "apiV1Prefix": "/api/v1",
    "apiKey": "YOUR_API_KEY"
  },
  "notes": [
    "This is a deployer-facing template, not a live production config.",
    "Replace host, SSH paths, and API key before using OpenCode helpers."
  ]
}
